{
  "provider_config": {
    "provider": "gemini-image",
    "base_url": "https://generativelanguage.googleapis.com",
    "auth": "provider_api_key"
  },
  "request": {
    "multipart": {
      "parts": [
        {
          "kind": "text",
          "name": "prompt",
          "value": "  add a scarf  "
        },
        {
          "kind": "file",
          "name": "image",
          "blob": "b0",
          "filename": "in.png",
          "bytes": 4096,
          "media_type": "image/png"
        }
      ]
    }
  },
  "context": {
    "upstream_model": "gemini-3.1-flash-image",
    "metering_required": [
      "tokens"
    ]
  }
}
