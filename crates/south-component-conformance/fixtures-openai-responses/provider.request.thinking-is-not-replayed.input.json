{
  "provider_config": {
    "provider": "openai-responses",
    "base_url": "https://api.openai.com/v1",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "gpt-5.5",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 400000,
        "supported_parameters": [
          "reasoning_effort",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "gpt-5.5",
    "messages": [
      {
        "role": "user",
        "content": "Is 91 prime?"
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "thinking",
            "thinking": "91 = 7 x 13."
          },
          {
            "type": "redacted_thinking",
            "data": "opaque"
          },
          {
            "type": "text",
            "text": "No: 91 = 7 x 13."
          }
        ]
      },
      {
        "role": "user",
        "content": "And 97?"
      }
    ]
  }
}
