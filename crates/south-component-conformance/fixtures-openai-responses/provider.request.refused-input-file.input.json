{
  "provider_config": {
    "provider": "openai-responses",
    "base_url": "https://api.openai.com/v1",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "gpt-5.5",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 400000,
        "supported_parameters": [
          "reasoning_effort",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "gpt-5.5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Summarize this report."
          },
          {
            "type": "input_file",
            "file_url": "https://www.example.org/annual-report.pdf"
          }
        ]
      }
    ]
  }
}
