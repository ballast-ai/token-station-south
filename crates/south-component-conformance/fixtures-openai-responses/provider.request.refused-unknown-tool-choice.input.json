{
  "provider_config": {
    "provider": "openai-responses",
    "base_url": "https://api.openai.com/v1",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "gpt-5.5",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 400000,
        "supported_parameters": [
          "reasoning_effort",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "gpt-5.5",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Paris, please."
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "description": "Current weather for a city.",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ]
        }
      }
    ],
    "tool_choice": {
      "type": "allowed_tools",
      "mode": "auto",
      "tools": [
        {
          "type": "function",
          "name": "get_weather"
        }
      ]
    }
  }
}
