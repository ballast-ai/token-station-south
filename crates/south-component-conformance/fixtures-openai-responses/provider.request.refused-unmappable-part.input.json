{
  "provider_config": {
    "provider": "openai-responses",
    "base_url": "https://api.openai.com/v1",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "gpt-5.5",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 400000,
        "supported_parameters": [
          "reasoning_effort",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "gpt-5.5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Summarize the attached document."
          },
          {
            "type": "document",
            "source": {
              "type": "text",
              "media_type": "text/plain",
              "data": "Q3 revenue grew."
            }
          }
        ]
      }
    ]
  }
}
