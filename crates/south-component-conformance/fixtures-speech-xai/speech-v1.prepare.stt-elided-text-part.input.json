{
  "provider_config": {
    "provider": "xai-speech",
    "base_url": "https://api.x.ai",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "grok-tts"
      },
      {
        "model": "grok-stt"
      }
    ]
  },
  "request": {
    "multipart": {
      "parts": [
        {
          "kind": "text",
          "name": "model",
          "value": "media/asr"
        },
        {
          "kind": "text",
          "name": "prompt",
          "blob": "b0",
          "bytes": 1048577,
          "head": "aaaa"
        },
        {
          "kind": "file",
          "name": "file",
          "blob": "b1",
          "filename": "a.mp3",
          "media_type": "audio/mpeg",
          "bytes": 9
        }
      ]
    }
  },
  "context": {
    "upstream_model": "grok-stt",
    "operation": "transcribe",
    "metering_required": [
      "seconds"
    ]
  }
}
