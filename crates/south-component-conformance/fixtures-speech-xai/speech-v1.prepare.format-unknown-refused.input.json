{
  "provider_config": {
    "provider": "xai-speech",
    "base_url": "https://api.x.ai",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "grok-tts"
      }
    ]
  },
  "request": {
    "json": {
      "model": "media/tts",
      "input": "hello world",
      "voice": "alloy",
      "response_format": "midi"
    }
  },
  "context": {
    "upstream_model": "grok-tts",
    "operation": "synthesize",
    "metering_required": [
      "characters"
    ]
  }
}
