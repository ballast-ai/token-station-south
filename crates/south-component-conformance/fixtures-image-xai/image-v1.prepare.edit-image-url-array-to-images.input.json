{
  "provider_config": {
    "provider": "xai-image",
    "base_url": "https://api.x.ai",
    "auth": "provider_api_key"
  },
  "request": {
    "json": {
      "model": "xai/grok-imagine-image-quality",
      "prompt": "p",
      "image_url": [
        {
          "$south.blob": {
            "id": "b0",
            "bytes": 25,
            "head": "https://example.com/a.png"
          }
        },
        {
          "$south.blob": {
            "id": "b1",
            "bytes": 25,
            "head": "https://example.com/b.png"
          }
        }
      ],
      "resolution": "2k"
    }
  },
  "context": {
    "upstream_model": "grok-imagine-image-quality",
    "metering_required": [
      "images"
    ]
  }
}
