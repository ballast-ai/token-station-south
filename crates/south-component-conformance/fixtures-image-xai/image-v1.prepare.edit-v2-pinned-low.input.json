{
  "provider_config": {
    "provider": "xai-image",
    "base_url": "https://api.x.ai",
    "auth": "provider_api_key"
  },
  "request": {
    "json": {
      "prompt": "p",
      "quality": "low",
      "resolution": "2k",
      "image": {
        "type": "image_url",
        "url": {
          "$south.blob": {
            "id": "b0",
            "bytes": 25,
            "head": "https://example.com/a.png"
          }
        }
      }
    }
  },
  "context": {
    "upstream_model": "grok-imagine-image-2.0",
    "metering_required": [
      "images"
    ]
  }
}
