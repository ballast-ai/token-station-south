{
  "provider_config": {
    "provider": "vertex-ai-image",
    "base_url": "https://us-central1-aiplatform.googleapis.com",
    "auth": "provider_api_key",
    "declared": {
      "project_id": "test-project",
      "region": "us-central1"
    }
  },
  "request": {
    "multipart": {
      "parts": [
        {
          "kind": "text",
          "name": "prompt",
          "value": "make the cat blue"
        },
        {
          "kind": "file",
          "name": "image",
          "blob": "b0",
          "bytes": 70000,
          "media_type": "image/png"
        }
      ]
    }
  },
  "context": {
    "upstream_model": "gemini-3.1-flash-image",
    "metering_required": [
      "tokens"
    ]
  }
}
