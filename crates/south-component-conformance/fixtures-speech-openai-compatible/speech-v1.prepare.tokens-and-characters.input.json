{
  "provider_config": {
    "provider": "openai-compatible",
    "base_url": "https://api.openai.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "gpt-4o-mini-tts"
      },
      {
        "model": "tts-1"
      }
    ]
  },
  "request": {
    "json": {
      "model": "media/tts",
      "input": "hello world",
      "voice": "alloy",
      "response_format": "opus"
    }
  },
  "context": {
    "upstream_model": "gpt-4o-mini-tts",
    "operation": "synthesize",
    "metering_required": [
      "characters",
      "tokens"
    ]
  }
}
