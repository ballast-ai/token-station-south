{
  "provider_config": {
    "provider": "azure-openai-v1",
    "base_url": "https://my-resource.services.ai.azure.com/openai/v1",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "gpt-4o-transcribe"
      }
    ]
  },
  "request": {
    "multipart": {
      "parts": [
        {
          "kind": "text",
          "name": "model",
          "value": "media/asr"
        },
        {
          "kind": "file",
          "name": "file",
          "blob": "b0",
          "filename": "a.mp3",
          "media_type": "audio/mpeg",
          "bytes": 9
        }
      ]
    }
  },
  "context": {
    "upstream_model": "gpt-4o-transcribe",
    "operation": "transcribe",
    "metering_required": [
      "seconds"
    ]
  }
}
