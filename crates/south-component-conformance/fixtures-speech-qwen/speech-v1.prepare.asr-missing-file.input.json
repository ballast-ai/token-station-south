{
  "provider_config": {
    "provider": "bailian-qwen-speech",
    "base_url": "https://ws-example.ap-southeast-1.maas.aliyuncs.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "qwen3-asr-flash"
      }
    ]
  },
  "request": {
    "multipart": {
      "parts": [
        {
          "kind": "text",
          "name": "model",
          "value": "media/asr"
        },
        {
          "kind": "text",
          "name": "file",
          "value": "not a file"
        }
      ]
    }
  },
  "context": {
    "upstream_model": "qwen3-asr-flash",
    "operation": "transcribe",
    "metering_required": [
      "seconds"
    ]
  }
}
