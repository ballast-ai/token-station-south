{
  "provider_config": {
    "provider": "azure-openai-dated",
    "base_url": "https://my-resource.openai.azure.com",
    "auth": "provider_api_key",
    "declared": {
      "api_version": "2024-10-21",
      "max_tokens_field": "max_tokens"
    },
    "models": [
      {
        "model": "gpt-5-5-deployment",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 400000
      }
    ]
  },
  "chat_request": {
    "model": "gpt-5-5-deployment",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Beijing?"
      }
    ],
    "sampling": {
      "max_output_tokens": 321
    },
    "stream": false
  }
}
