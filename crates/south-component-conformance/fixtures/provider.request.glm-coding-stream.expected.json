{
  "method": "POST",
  "url": "https://api.z.ai/api/coding/paas/v4/chat/completions",
  "headers": {
    "content-type": "application/json"
  },
  "body": {
    "model": "glm-4.6",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Beijing?"
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  },
  "auth": {
    "scheme": "bearer",
    "secret": "provider_api_key"
  }
}
