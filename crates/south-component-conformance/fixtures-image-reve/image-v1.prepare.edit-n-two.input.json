{
  "provider_config": {
    "provider": "reve-image",
    "base_url": "https://api.reve.com",
    "auth": "provider_api_key"
  },
  "request": {
    "multipart": {
      "parts": [
        {
          "kind": "text",
          "name": "endpoint",
          "value": "edit"
        },
        {
          "kind": "text",
          "name": "prompt",
          "value": "p"
        },
        {
          "kind": "file",
          "name": "image",
          "blob": "b0",
          "filename": "in.png",
          "bytes": 4096,
          "media_type": "image/png"
        },
        {
          "kind": "text",
          "name": "n",
          "value": "2"
        }
      ]
    }
  },
  "context": {
    "upstream_model": "latest",
    "metering_required": [
      "credits"
    ]
  }
}
