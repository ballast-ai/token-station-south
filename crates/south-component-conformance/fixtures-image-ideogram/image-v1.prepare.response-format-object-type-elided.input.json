{
  "provider_config": {
    "provider": "ideogram-image",
    "base_url": "https://api.ideogram.ai",
    "auth": "provider_api_key"
  },
  "request": {
    "json": {
      "prompt": "a red fox",
      "response_format": {
        "type": {
          "$south.blob": {
            "id": "b0",
            "bytes": 1048577,
            "head": "b64_json b64_json b64_json"
          }
        }
      }
    }
  },
  "context": {
    "upstream_model": "ideogram-v4-turbo",
    "metering_required": [
      "images"
    ]
  }
}
