{
  "provider_config": {
    "provider": "minimax-speech",
    "base_url": "https://api.minimax.io",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "speech-2.6-hd"
      },
      {
        "model": "speech-02-hd"
      }
    ]
  },
  "request": {
    "json": {
      "model": "media/tts",
      "input": "hello world",
      "voice": "alloy",
      "stream": true,
      "output_format": "url",
      "instructions": "calm",
      "language": "en",
      "text": "other"
    }
  },
  "context": {
    "upstream_model": "speech-2.6-hd",
    "operation": "synthesize",
    "metering_required": [
      "characters"
    ]
  }
}
