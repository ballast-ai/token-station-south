{
  "provider_config": {
    "provider": "bailian-minimax-speech",
    "base_url": "https://dashscope.aliyuncs.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "MiniMax/speech-2.8-hd"
      },
      {
        "model": "MiniMax/speech-2.8-turbo"
      }
    ]
  },
  "request": {
    "json": {
      "input": "hello world",
      "voice": "moss_audio_cloned_1",
      "speed": 1,
      "voice_setting": {
        "voice_id": "ignored",
        "vol": 2,
        "pitch": -1,
        "emotion": "happy"
      },
      "audio_setting": {
        "format": "wav",
        "sample_rate": 32000,
        "bitrate": 128000
      }
    }
  },
  "context": {
    "upstream_model": "MiniMax/speech-2.8-hd",
    "operation": "synthesize",
    "metering_required": [
      "characters"
    ]
  }
}
