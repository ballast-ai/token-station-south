{
  "provider_config": {
    "provider": "bailian-minimax-speech",
    "base_url": "https://dashscope.aliyuncs.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "MiniMax/speech-2.8-hd"
      },
      {
        "model": "MiniMax/speech-2.8-turbo"
      }
    ]
  },
  "request": {
    "json": {
      "input": "hello world",
      "speed": 2,
      "voice_setting": {
        "speed": 0.8
      }
    }
  },
  "context": {
    "upstream_model": "MiniMax/speech-2.8-hd",
    "operation": "synthesize",
    "metering_required": [
      "characters"
    ]
  }
}
