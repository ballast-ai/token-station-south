{
  "provider_config": {
    "provider": "azure-speech",
    "base_url": "https://eastus.cognitiveservices.azure.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "MAI-Voice-2"
      },
      {
        "model": "mai-transcribe-1.5"
      }
    ]
  },
  "request": {
    "json": {
      "input": "hello world",
      "response_format": "opus"
    }
  },
  "context": {
    "upstream_model": "MAI-Voice-2",
    "operation": "synthesize",
    "metering_required": [
      "characters"
    ]
  }
}
