{
  "provider_config": {
    "provider": "vertex-ai",
    "base_url": "https://aiplatform.googleapis.com",
    "auth": "provider_api_key",
    "declared": {
      "project_id": "test-project",
      "region": "global"
    },
    "models": [
      {
        "model": "gemini-3.8-flash",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 1048576,
        "supported_parameters": [
          "stop",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "gemini-3.8-flash",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "sampling": {
      "max_output_tokens": 16
    }
  }
}
