{
  "provider_config": {
    "provider": "vertex-ai",
    "base_url": "https://us-central1-aiplatform.googleapis.com",
    "auth": "provider_api_key",
    "declared": {
      "project_id": "test-project",
      "region": "us-central1"
    },
    "models": [
      {
        "model": "gemini-2.5-pro",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 1000000,
        "supported_parameters": [
          "stop",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "gemini-2.5-pro",
    "messages": [
      {
        "role": "system",
        "content": "Be terse."
      },
      {
        "role": "user",
        "content": "Weather in Beijing?"
      }
    ],
    "sampling": {
      "temperature": 0.2,
      "max_output_tokens": 512
    }
  }
}
