{
  "provider_config": {
    "provider": "bailian-qwen-image",
    "base_url": "https://dashscope.aliyuncs.com",
    "auth": "provider_api_key"
  },
  "request": {
    "json": {
      "prompt": "a red panda",
      "n": 2,
      "size": "1328x1328",
