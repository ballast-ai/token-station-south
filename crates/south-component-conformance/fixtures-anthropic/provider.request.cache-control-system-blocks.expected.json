{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json"
  },
  "auth": {
    "scheme": "header",
    "name": "x-api-key",
    "secret": "provider_api_key"
  },
  "body": {
    "model": "claude-x",
    "system": [
      {
        "type": "text",
        "text": "Rules."
      },
      {
        "type": "text",
        "text": "Long reference text.",
        "cache_control": {
          "type": "ephemeral",
          "ttl": "1h"
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "max_tokens": 64
  }
}
