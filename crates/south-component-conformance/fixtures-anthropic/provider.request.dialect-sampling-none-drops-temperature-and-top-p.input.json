{
  "provider_config": {
    "provider": "anthropic",
    "base_url": "https://api.anthropic.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "claude-x",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": [
          "anthropic.sampling.none"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "claude-x",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "sampling": {
      "max_output_tokens": 4096,
      "temperature": 0.2,
      "top_p": 0.5
    }
  }
}
