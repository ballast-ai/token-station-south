{
  "provider_config": {
    "provider": "anthropic",
    "base_url": "https://api.anthropic.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "claude-sonnet-4",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": [
          "stop",
          "temperature",
          "top_p",
          "reasoning_replay.claude.v1"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "claude-sonnet-4",
    "messages": [
      {
        "role": "user",
        "content": "Continue."
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "thinking",
            "thinking": "Weighed both options.",
            "signature": "SIG-1"
          },
          {
            "type": "thinking",
            "thinking": "",
            "signature": "SIG-EMPTY"
          },
          {
            "type": "redacted_thinking",
            "data": "OPAQUE"
          },
          {
            "type": "text",
            "text": "Option B."
          }
        ],
        "reasoning_replay_protocol_family": "claude-signed-thinking",
        "reasoning_replay_block_layout": [
          {"kind": "content", "ordinal": 0},
          {"kind": "content", "ordinal": 1},
          {"kind": "content", "ordinal": 2},
          {"kind": "content", "ordinal": 3}
        ]
      }
    ],
    "sampling": {
      "max_output_tokens": 32
    }
  }
}
