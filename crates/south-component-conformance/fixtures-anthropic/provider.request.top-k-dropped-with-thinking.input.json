{
  "provider_config": {
    "provider": "anthropic",
    "base_url": "https://api.anthropic.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "claude-x",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": []
      }
    ]
  },
  "chat_request": {
    "model": "claude-x",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "sampling": {
      "max_output_tokens": 4096,
      "temperature": 0.5,
      "top_k": 40
    },
    "reasoning_mode": "enabled",
    "reasoning_budget_tokens": 2048
  }
}
