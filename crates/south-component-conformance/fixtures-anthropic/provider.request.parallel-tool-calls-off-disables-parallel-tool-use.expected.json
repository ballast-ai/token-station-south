{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json"
  },
  "auth": {
    "scheme": "header",
    "name": "x-api-key",
    "secret": "provider_api_key"
  },
  "body": {
    "model": "claude-x",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Beijing?"
      }
    ],
    "max_tokens": 64,
    "tools": [
      {
        "name": "get_weather",
        "description": "Look up weather",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          }
        }
      }
    ],
    "tool_choice": {
      "type": "auto",
      "disable_parallel_tool_use": true
    }
  }
}
