{
  "provider_config": {
    "provider": "anthropic",
    "base_url": "https://api.anthropic.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "claude-x",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": []
      }
    ]
  },
  "chat_request": {
    "model": "claude-x",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "a",
            "cache_control": {
              "type": "ephemeral",
              "ttl": "5m"
            }
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "data:image/png;base64,AAAA"
            },
            "cache_control": {
              "type": "ephemeral"
            }
          },
          {
            "type": "text",
            "text": "b"
          }
        ]
      }
    ],
    "sampling": {
      "max_output_tokens": 64
    }
  }
}
