{
  "provider_config": {
    "provider": "bedrock-bearer",
    "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com",
    "models": [
      {
        "model": "anthropic.claude-x-v1:0",
        "tool": true,
        "vision": true,
        "json_schema": false,
        "context_window": 200000,
        "supported_parameters": [
          "bedrock.converse.cache_point"
        ]
      }
    ],
    "auth": "provider_api_key"
  },
  "chat_request": {
    "model": "anthropic.claude-x-v1:0",
    "messages": [
      {
        "role": "system",
        "content": [
          {
            "type": "text",
            "text": "Rules.",
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Long reference text.",
            "cache_control": {
              "type": "ephemeral",
              "ttl": "5m"
            }
          },
          {
            "type": "text",
            "text": "Question?"
          }
        ]
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "description": "Look up weather",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          }
        },
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "tool_choice": "auto",
    "sampling": {
      "max_output_tokens": 512
    }
  }
}
