{
  "method": "POST",
  "url": "https://bedrock-runtime.us-east-1.amazonaws.com/model/anthropic.claude-x-v1:0/converse",
  "headers": {
    "accept": "application/json",
    "content-type": "application/json",
    "x-amzn-bedrock-accept": "application/json"
  },
  "body": {
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "text": "Weather in Beijing?"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "toolUse": {
              "toolUseId": "tu_1",
              "name": "get_weather",
              "input": {
                "city": "Beijing"
              }
            }
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "toolResult": {
              "toolUseId": "tu_1",
              "content": [
                {
                  "text": "18C\nsunny"
                }
              ]
            }
          },
          {
            "cachePoint": {
              "type": "default",
              "ttl": "1h"
            }
          }
        ]
      }
    ],
    "inferenceConfig": {
      "maxTokens": 512
    },
    "toolConfig": {
      "tools": [
        {
          "toolSpec": {
            "name": "get_weather",
            "description": "Look up weather",
            "inputSchema": {
              "json": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ],
      "toolChoice": {
        "auto": {}
      }
    }
  },
  "auth": {
    "scheme": "bearer",
    "secret": "provider_api_key"
  }
}
