{
  "provider_config": {
    "provider": "bedrock-bearer",
    "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com",
    "models": [
      {
        "model": "anthropic.claude-x-v1:0",
        "tool": true,
        "vision": true,
        "json_schema": false,
        "context_window": 200000,
        "supported_parameters": [
          "bedrock.converse.cache_point",
          "bedrock.converse.cache_point.tools",
          "bedrock.converse.cache_point.ttl_1h"
        ]
      }
    ],
    "auth": "provider_api_key"
  },
  "chat_request": {
    "model": "anthropic.claude-x-v1:0",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Long reference text.",
            "cache_control": {
              "type": "ephemeral",
              "ttl": "1h"
            }
          },
          {
            "type": "text",
            "text": "Question?"
          }
        ]
      }
    ],
    "sampling": {
      "max_output_tokens": 512
    }
  }
}
