{
  "provider_config": {
    "provider": "gemini",
    "base_url": "https://generativelanguage.googleapis.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "gemini-2.5-pro",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 1000000,
        "supported_parameters": [
          "stop",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "gemini-2.5-pro",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Beijing and Paris?"
      },
      {
        "role": "assistant",
        "tool_calls": [
          {
            "id": "call_0_get_weather",
            "name": "get_weather",
            "arguments": "{\"city\":\"Beijing\"}",
            "signature": "sig-step-1"
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_0_get_weather",
        "content": "18C"
      },
      {
        "role": "assistant",
        "tool_calls": [
          {
            "id": "call_1_get_weather",
            "name": "get_weather",
            "arguments": "{\"city\":\"Paris\"}",
            "signature": "sig-step-2"
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_1_get_weather",
        "content": "21C"
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "description": "Look up weather",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          }
        }
      }
    ],
    "tool_choice": "auto"
  }
}
