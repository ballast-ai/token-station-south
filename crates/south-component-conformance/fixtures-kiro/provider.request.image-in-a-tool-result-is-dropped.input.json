{
  "provider_config": {
    "provider": "kiro",
    "base_url": "https://q.us-east-1.amazonaws.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "claude-sonnet-4.5",
        "tool": true,
        "vision": false,
        "json_schema": false,
        "context_window": 200000,
        "supported_parameters": []
      }
    ],
    "declared": {
      "profile_arn": "arn:aws:codewhisperer:us-east-1:123456789012:profile/FAKEPROFILE"
    }
  },
  "chat_request": {
    "model": "claude-sonnet-4.5",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Paris and Rome?"
      },
      {
        "role": "assistant",
        "tool_calls": [
          {
            "id": "call_a",
            "name": "get_weather",
            "arguments": "{\"city\":\"Paris\"}"
          },
          {
            "id": "call_b",
            "name": "get_weather",
            "arguments": "{\"city\":\"Rome\"}"
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_a",
        "content": [
          {
            "type": "text",
            "text": "sunny"
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "data:image/png;base64,AAAA"
            }
          },
          {
            "type": "text",
            "text": " and warm"
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_b",
        "content": [
          {
            "type": "text",
            "text": "rain",
            "cache_control": {
              "type": "ephemeral"
            }
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "https://example.com/radar.png"
            },
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ]
      }
    ],
    "host_values": {
      "attempt_id": "3f2c8a9e-6b1d-4c7a-9e0f-5a4b3c2d1e0f"
    }
  }
}
