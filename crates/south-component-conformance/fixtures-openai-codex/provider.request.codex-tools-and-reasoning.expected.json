{
  "auth": {
    "scheme": "bearer",
    "secret": "provider_api_key"
  },
  "body": {
    "include": [
      "reasoning.encrypted_content"
    ],
    "input": [
      {
        "content": [
          {
            "text": "Weather in Paris?",
            "type": "input_text"
          }
        ],
        "role": "user"
      }
    ],
    "instructions": "You are a helpful assistant.",
    "model": "gpt-5-codex",
