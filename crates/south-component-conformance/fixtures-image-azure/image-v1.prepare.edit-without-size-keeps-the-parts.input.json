{
  "provider_config": {
    "provider": "azure-mai",
    "base_url": "https://example-resource.services.ai.azure.com",
    "auth": "provider_api_key"
  },
  "context": {
    "upstream_model": "MAI-Image-2.5",
    "metering_required": [
      "tokens"
    ]
  },
  "request": {
    "multipart": {
      "parts": [
        {
          "kind": "text",
          "name": "prompt",
          "value": "add a hat"
        },
        {
          "kind": "file",
          "name": "image",
          "blob": "b0",
          "filename": "cat.png",
          "media_type": "image/png",
          "bytes": 1234
        },
        {
          "kind": "file",
          "name": "mask",
          "blob": "b1",
          "filename": "mask.png",
          "media_type": "image/png",
          "bytes": 321
        }
      ]
    }
  }
}
