{
  "provider_config": {
    "provider": "claude-code-setup-token",
    "base_url": "https://api.anthropic.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "claude-sonnet-4-5",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": [
          "stop",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "claude-sonnet-4-5",
    "messages": [
      {
        "role": "user",
        "content": "hello"
      }
    ],
    "sampling": {
      "max_output_tokens": 321
    }
  }
}
