{
  "provider_config": {
    "provider": "anthropic-bedrock-invoke",
    "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com",
    "models": [
      {
        "model": "anthropic.claude-sonnet-4-v1:0",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": [
          "stop",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "anthropic.claude-sonnet-4-v1:0",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  }
}
