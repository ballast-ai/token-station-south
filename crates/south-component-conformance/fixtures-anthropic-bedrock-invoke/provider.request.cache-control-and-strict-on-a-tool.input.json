{
  "provider_config": {
    "provider": "anthropic-bedrock-invoke",
    "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com",
    "models": [
      {
        "model": "claude-x",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": []
      }
    ]
  },
  "chat_request": {
    "model": "claude-x",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Beijing?"
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "description": "Look up weather",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          }
        },
        "strict": true,
        "cache_control": {
          "type": "ephemeral",
          "ttl": "1h"
        }
      }
    ],
    "tool_choice": "auto",
    "sampling": {
      "max_output_tokens": 64
    }
  }
}
