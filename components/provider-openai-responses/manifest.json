{
  "name": "provider-openai-responses",
  "version": "1.3.0",
  "api_version": "provider-adapter-v2",
  "providers": [
    "openai-responses",
    "openai-codex"
  ],
  "capabilities": [
    "chat",
    "json_schema",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "bearer"
  ],
  "request_facts": {
    "openai-responses": {
      "output_cap": [
        "/max_output_tokens"
      ],
      "model": {
        "body": "/model"
      },
      "stream": {
        "body": "/stream"
      }
    },
    "openai-codex": {
      "output_cap": [],
      "model": {
        "body": "/model"
      },
      "stream": {
        "body": "/stream"
      }
    }
  },
  "immutable_body_paths": {
    "openai-responses": [
      "store"
    ],
    "openai-codex": [
      "store",
      "stream",
      "instructions",
      "temperature",
      "max_output_tokens"
    ]
  },
  "north_passthrough": {
    "openai-responses": "responses",
    "openai-codex": "responses"
  },
  "credentials": {
    "schema": "south.credential-recipe.v1",
    "families": [
      "openai-codex"
    ],
    "fields": {
      "access_token": {
        "secret": true,
        "description": "A Codex access token, such as tokens.access_token in the Codex CLI's auth.json. Used as is when no refresh token is stored."
      },
      "refresh_token": {
        "secret": true,
        "description": "The Codex refresh token, such as tokens.refresh_token in the Codex CLI's auth.json. Rotated on every refresh and written back."
      },
      "account_id": {
        "secret": false,
        "syntax": "token",
        "description": "The ChatGPT account id, such as tokens.account_id in the Codex CLI's auth.json. Sent as chatgpt-account-id; a refresh naming another account is refused."
      }
    },
    "require_one_of": [
      [
        "access_token",
        "refresh_token"
      ]
    ],
    "import": {
      "access_token": {
        "file": "codex-auth-json",
        "pointers": [
          "/tokens/access_token"
        ]
      },
      "account_id": {
        "file": "codex-auth-json",
        "pointers": [
          "/tokens/account_id"
        ]
      },
      "refresh_token": {
        "file": "codex-auth-json",
        "pointers": [
          "/tokens/refresh_token"
        ]
      }
    },
    "slots": {
      "provider_api_key": {
        "minted": "codex"
      }
    },
    "recipes": {
      "codex": {
        "steps": [
          {
            "id": "refresh",
            "kind": "oauth2_token",
            "encoding": "json",
            "endpoint": "https://auth.openai.com/oauth/token",
            "requires": [
              "refresh_token"
            ],
            "params": {
              "client_id": {
                "const": "app_EMoamEEZ73f0CkXaXp7hrann"
              },
              "grant_type": {
                "const": "refresh_token"
              },
              "refresh_token": {
                "field": "refresh_token"
              },
              "scope": {
                "const": "openid profile email offline_access"
              }
            },
            "on_status": {
              "429": "transient"
            },
            "extract": {
              "access_token": {
                "pointer": "/access_token",
                "secret": true
              },
              "account": {
                "jwt_claim": {
                  "token": "/id_token",
                  "pointer": "/https:~1~1api.openai.com~1auth/chatgpt_account_id"
                },
                "optional": true,
                "must_equal_field": "account_id"
              },
              "expires_at": {
                "fixed_window": true
              },
              "refresh_token": {
                "pointer": "/refresh_token",
                "secret": true,
                "optional": true
              }
            }
          }
        ],
        "present": "refresh.access_token",
        "rotates_refresh_material": true,
        "write_back": {
          "refresh_token": "refresh.refresh_token"
        },
        "without_refresh_material": "use_stored",
        "fixed_validity_seconds": 3000,
        "attributes": {
          "account_id": {
            "field": "account_id",
            "export": true,
            "persist": true
          }
        }
      }
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures-openai-responses/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.6.0/v0.5.0",
    "kernel_version": "0.5.0",
    "kernel_revision": "c0bca10c2d9f9a439680865feb65c9edf598fc65",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.54.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 4,
      "error_catalog": 1,
      "stream": 2
    }
  }
}
