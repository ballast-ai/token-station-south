{
  "name": "speech-openai-compatible",
  "version": "1.3.1",
  "api_version": "speech-adapter-v1",
  "providers": [
    "openai-compatible",
    "azure-openai-v1",
    "azure-openai-dated"
  ],
  "capabilities": [
    "synthesize",
    "transcribe",
    "translate"
  ],
  "auth_arms": [
    "bearer",
    "header_secret"
  ],
  "config_schema": {
    "azure-openai-dated": {
      "api_version": {
        "syntax": "api_version_date",
        "default": "2024-10-21",
        "description": "The Azure OpenAI API version sent as ?api-version=, a date with an optional -preview suffix such as 2025-04-01-preview. Defaults to 2024-10-21. A row on Azure's unversioned v1 surface uses the azure-openai-v1 family instead."
      }
    }
  },
  "served_models": {
    "azure-openai-dated": {
      "any": true
    },
    "azure-openai-v1": {
      "any": true
    },
    "openai-compatible": {
      "any": true
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "conformance": {
    "required_suite": "south.speech-component.v1",
    "fixtures": "fixtures-speech-openai-compatible/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.7.0/v0.6.0",
    "kernel_version": "0.6.0",
    "kernel_revision": "a04925518b95c6557374252db7fbe7f026688bde",
    "wit_package": "token-station:speech-adapter@1.0.0",
    "south_runtime": "0.81.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 5,
      "error_catalog": 1,
      "stream": 3
    },
    "contracts": {
      "media": 1,
      "speech": 1
    }
  }
}
