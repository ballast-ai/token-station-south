{
  "name": "provider-openai-compatible",
  "version": "2.4.0",
  "api_version": "provider-adapter-v2",
  "providers": [
    "openai-compatible",
    "azure-openai-v1",
    "github-copilot",
    "gemini-openai-compatible"
  ],
  "capabilities": [
    "chat",
    "json_schema",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "bearer",
    "bearer_and_header_secret",
    "header_secret"
  ],
  "credentials": {
    "schema": "south.credential-recipe.v1",
    "families": [
      "github-copilot"
    ],
    "fields": {
      "github_token": {
        "secret": true,
        "required": true,
        "description": "A GitHub OAuth token from an account with a Copilot seat, such as the oauth_token in the editor's github-copilot/apps.json or hosts.json."
      }
    },
    "import": {
      "github_token": {
        "file": "github-copilot-editor-json",
        "pointers": [
          "/github.com/oauth_token",
          "/github.com:Iv1.b507a08c87ecfe98/oauth_token"
        ]
      }
    },
    "slots": {
      "provider_api_key": {
        "minted": "copilot"
      }
    },
    "recipes": {
      "copilot": {
        "steps": [
          {
            "id": "exchange",
            "kind": "http_exchange",
            "method": "GET",
            "endpoint": "https://api.github.com/copilot_internal/v2/token",
            "headers": {
              "accept": {
                "const": "application/json"
              },
              "editor-plugin-version": {
                "const": "copilot-chat/0.43.0"
              },
              "editor-version": {
                "const": "vscode/1.123.0"
              },
              "user-agent": {
                "const": "GitHubCopilotChat/0.43.0"
              },
              "x-github-api-version": {
                "const": "2025-04-01"
              }
            },
            "auth": {
              "scheme": "token",
              "value": {
                "field": "github_token"
              }
            },
            "on_status": {
              "404": {
                "goto": "direct"
              },
              "429": "transient"
            },
            "extract": {
              "token": {
                "pointer": "/token",
                "secret": true
              },
              "expires_at": {
                "epoch_seconds": "/expires_at"
              }
            }
          },
          {
            "id": "direct",
            "kind": "http_probe",
            "method": "GET",
            "endpoint": "https://api.github.com/copilot_internal/user",
            "headers": {
              "accept": {
                "const": "application/json"
              },
              "editor-plugin-version": {
                "const": "copilot-chat/0.43.0"
              },
              "editor-version": {
                "const": "vscode/1.123.0"
              },
              "user-agent": {
                "const": "GitHubCopilotChat/0.43.0"
              },
              "x-github-api-version": {
                "const": "2025-04-01"
              }
            },
            "auth": {
              "scheme": "token",
              "value": {
                "field": "github_token"
              }
            },
            "on_status": {
              "429": "transient"
            }
          }
        ],
        "present": [
          "exchange.token",
          {
            "field": "github_token",
            "validity_seconds": 3600
          }
        ],
        "rotates_refresh_material": false,
        "refresh_margin_seconds": 30
      }
    }
  },
  "endpoint": {
    "gemini-openai-compatible": "https://generativelanguage.googleapis.com/v1beta/openai",
    "github-copilot": "https://api.{plan}.githubcopilot.com"
  },
  "config_schema": {
    "github-copilot": {
      "plan": {
        "syntax": {
          "enum": [
            "individual",
            "business",
            "enterprise"
          ]
        },
        "required": true,
        "description": "The account's Copilot plan, which selects GitHub's chat API host: individual (Pro and Pro+), business or enterprise. Required: a Business or Enterprise account routed to the individual host fails only when the upstream refuses it."
      }
    }
  },
  "user_agent": {
    "github-copilot": "GitHubCopilotChat/0.43.0"
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.5.0/v0.4.0",
    "kernel_version": "0.4.0",
    "kernel_revision": "8e34f5a089d0b9c7273b49ddb6952dd87e960019",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.46.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 3,
      "error_catalog": 1,
      "stream": 2
    }
  }
}
