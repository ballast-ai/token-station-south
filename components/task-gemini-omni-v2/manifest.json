{
  "name": "task-gemini-omni-v2",
  "version": "0.2.9",
  "api_version": "task-adapter-v2",
  "providers": [
    "gemini-interactions-video",
    "vertex-interactions-video"
  ],
  "capabilities": [
    "submit",
    "observe",
    "render"
  ],
  "auth_arms": [
    "bearer",
    "header_secret"
  ],
  "credentials": {
    "schema": "south.credential-recipe.v1",
    "families": [
      "vertex-interactions-video"
    ],
    "fields": {
      "service_account": {
        "secret": true,
        "required": true,
        "media": "application/json",
        "description": "The service account key file (JSON) access tokens are minted with."
      },
      "project_id": {
        "secret": false,
        "required": true,
        "syntax": "gcp_project_id",
        "description": "The Google Cloud project the service account belongs to."
      }
    },
    "import": {
      "service_account": {
        "file": "service-account-json",
        "pointers": [
          ""
        ]
      },
      "project_id": {
        "file": "service-account-json",
        "pointers": [
          "/project_id"
        ]
      }
    },
    "slots": {
      "provider_api_key": {
        "minted": "vertex_sa"
      }
    },
    "recipes": {
      "vertex_sa": {
        "steps": [
          {
            "id": "assertion",
            "kind": "jwt_sign",
            "alg": "RS256",
            "key": {
              "field": "service_account",
              "pointer": "/private_key"
            },
            "claims": {
              "iss": {
                "field": "service_account",
                "pointer": "/client_email"
              },
              "scope": {
                "const": "https://www.googleapis.com/auth/cloud-platform"
              },
              "aud": {
                "endpoint_of": "token"
              },
              "iat": {
                "now_plus": 0
              },
              "exp": {
                "now_plus": 600
              }
            }
          },
          {
            "id": "token",
            "kind": "oauth2_token",
            "encoding": "form",
            "endpoint": "https://oauth2.googleapis.com/token",
            "params": {
              "grant_type": {
                "const": "urn:ietf:params:oauth:grant-type:jwt-bearer"
              },
              "assertion": {
                "output": "assertion.jwt"
              }
            },
            "extract": {
              "access_token": {
                "pointer": "/access_token",
                "secret": true
              },
              "expires_at": {
                "relative_seconds": "/expires_in"
              }
            }
          }
        ],
        "present": "token.access_token",
        "rotates_refresh_material": false,
        "refresh_margin_seconds": 300,
        "min_ttl_seconds": 301
      }
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "response_blob_paths": [
    "/steps/*/content/*/data",
    "/output_video/data"
  ],
  "token_buckets": [
    "text_input",
    "image_input",
    "cached_input",
    "video_output",
    "reasoning_output",
    "total_input",
    "total_output"
  ],
  "required_token_buckets": [
    "video_output",
    "reasoning_output",
    "total_input",
    "total_output"
  ],
  "conformance": {
    "required_suite": "south.task-component.v2",
    "fixtures": "fixtures-gemini-omni-task-v2/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.7.0/v0.6.0",
    "kernel_version": "0.6.0",
    "kernel_revision": "a04925518b95c6557374252db7fbe7f026688bde",
    "wit_package": "token-station:task-adapter@2.0.0",
    "south_runtime": "0.77.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 5,
      "error_catalog": 1,
      "stream": 3
    },
    "contracts": {
      "media": 1,
      "task": 8
    }
  }
}
