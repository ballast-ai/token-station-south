{
  "name": "speech-vertex",
  "version": "1.2.0",
  "api_version": "speech-adapter-v1",
  "providers": [
    "vertex-ai-speech"
  ],
  "capabilities": [
    "synthesize"
  ],
  "auth_arms": [
    "bearer"
  ],
  "config_schema": {
    "vertex-ai-speech": {
      "region": {
        "syntax": "aws_region",
        "required": true,
        "description": "The Vertex AI location, such as us-central1, or global."
      },
      "project": {
        "syntax": "gcp_project_id",
        "description": "The Google Cloud project to call, when it is not the service account's own."
      }
    }
  },
  "credentials": {
    "schema": "south.credential-recipe.v1",
    "fields": {
      "service_account": {
        "secret": true,
        "required": true,
        "media": "application/json",
        "description": "The service account key file (JSON) access tokens are minted with."
      },
      "project_id": {
        "secret": false,
        "required": true,
        "syntax": "gcp_project_id",
        "description": "The Google Cloud project the service account belongs to."
      }
    },
    "import": {
      "service_account": {
        "file": "service-account-json",
        "pointers": [
          ""
        ]
      },
      "project_id": {
        "file": "service-account-json",
        "pointers": [
          "/project_id"
        ]
      }
    },
    "slots": {
      "provider_api_key": {
        "minted": "vertex_sa"
      }
    },
    "recipes": {
      "vertex_sa": {
        "steps": [
          {
            "id": "assertion",
            "kind": "jwt_sign",
            "alg": "RS256",
            "key": {
              "field": "service_account",
              "pointer": "/private_key"
            },
            "claims": {
              "iss": {
                "field": "service_account",
                "pointer": "/client_email"
              },
              "scope": {
                "const": "https://www.googleapis.com/auth/cloud-platform"
              },
              "aud": {
                "endpoint_of": "token"
              },
              "iat": {
                "now_plus": 0
              },
              "exp": {
                "now_plus": 600
              }
            }
          },
          {
            "id": "token",
            "kind": "oauth2_token",
            "encoding": "form",
            "endpoint": "https://oauth2.googleapis.com/token",
            "params": {
              "grant_type": {
                "const": "urn:ietf:params:oauth:grant-type:jwt-bearer"
              },
              "assertion": {
                "output": "assertion.jwt"
              }
            },
            "extract": {
              "access_token": {
                "pointer": "/access_token",
                "secret": true
              },
              "expires_at": {
                "relative_seconds": "/expires_in"
              }
            }
          }
        ],
        "present": "token.access_token",
        "rotates_refresh_material": false,
        "refresh_margin_seconds": 300,
        "min_ttl_seconds": 301,
        "attributes": {
          "project_id": {
            "field": "project_id",
            "export": true
          }
        }
      }
    }
  },
  "served_models": {
    "vertex-ai-speech": {
      "prefixes": [
        "gemini-2.5-flash-preview-tts",
        "gemini-2.5-flash-tts",
        "gemini-2.5-pro-preview-tts",
        "gemini-2.5-pro-tts"
      ]
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "conformance": {
    "required_suite": "south.speech-component.v1",
    "fixtures": "fixtures-speech-vertex/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.7.0/v0.6.0",
    "kernel_version": "0.6.0",
    "kernel_revision": "a04925518b95c6557374252db7fbe7f026688bde",
    "wit_package": "token-station:speech-adapter@1.0.0",
    "south_runtime": "0.77.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 5,
      "error_catalog": 1,
      "stream": 3
    },
    "contracts": {
      "media": 1,
      "speech": 1
    }
  }
}
