{
  "name": "provider-bedrock-converse-bearer",
  "version": "1.2.3",
  "api_version": "provider-adapter-v2",
  "providers": [
    "bedrock-bearer"
  ],
  "capabilities": [
    "chat",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "bearer"
  ],
  "endpoint": {
    "bedrock-bearer": "https://bedrock-runtime.{region}.amazonaws.com"
  },
  "config_schema": {
    "bedrock-bearer": {
      "region": {
        "syntax": "aws_region",
        "required": true,
        "description": "The AWS region the Bedrock runtime is called in."
      }
    }
  },
  "model_parameters": {
    "bedrock-bearer": {
      "words": [
        "anthropic.effort.xhigh",
        "anthropic.sampling.exclusive",
        "anthropic.sampling.none",
        "anthropic.thinking.adaptive",
        "anthropic.thinking.budget",
        "anthropic.tool_choice.auto_only",
        "bedrock.converse.cache_point",
        "bedrock.converse.cache_point.tools",
        "bedrock.converse.cache_point.ttl_1h",
        "reasoning_replay.claude.v1"
      ],
      "exclusive": [
        [
          "anthropic.thinking.adaptive",
          "anthropic.thinking.budget"
        ]
      ]
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures-bedrock-converse-bearer/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.7.0/v0.6.0",
    "kernel_version": "0.6.0",
    "kernel_revision": "a04925518b95c6557374252db7fbe7f026688bde",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.77.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 5,
      "error_catalog": 1,
      "stream": 3
    }
  },
  "stream_framing": "aws-eventstream",
  "request_facts": {
    "bedrock-bearer": {
      "output_cap": [
        "/inferenceConfig/maxTokens"
      ],
      "model": {
        "url": "/model/{model}/converse"
      },
      "stream": "url"
    }
  }
}
