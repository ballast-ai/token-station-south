{
  "name": "provider-bedrock-converse",
  "version": "1.2.1",
  "api_version": "provider-adapter-v2",
  "providers": [
    "bedrock"
  ],
  "capabilities": [
    "chat",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "host_signed"
  ],
  "endpoint": {
    "bedrock": "https://bedrock-runtime.{region}.amazonaws.com"
  },
  "config_schema": {
    "bedrock": {
      "region": {
        "syntax": "aws_region",
        "required": true,
        "description": "The AWS region the Bedrock runtime is called in."
      }
    }
  },
  "credentials": {
    "schema": "south.credential-recipe.v1",
    "fields": {
      "access_key_id": {
        "secret": true,
        "required": true,
        "description": "The AWS access key ID of the IAM principal the requests are signed as."
      },
      "secret_access_key": {
        "secret": true,
        "required": true,
        "description": "The AWS secret access key paired with the access key ID."
      },
      "session_token": {
        "secret": true,
        "description": "The AWS session token, only for temporary credentials from AWS STS."
      }
    }
  },
  "model_parameters": {
    "bedrock": {
      "words": [
        "anthropic.effort.xhigh",
        "anthropic.sampling.exclusive",
        "anthropic.sampling.none",
        "anthropic.thinking.adaptive",
        "anthropic.thinking.budget",
        "anthropic.tool_choice.auto_only",
        "bedrock.converse.cache_point",
        "bedrock.converse.cache_point.tools",
        "bedrock.converse.cache_point.ttl_1h",
        "reasoning_replay.claude.v1"
      ],
      "exclusive": [
        [
          "anthropic.thinking.adaptive",
          "anthropic.thinking.budget"
        ]
      ]
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": []
  },
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures-bedrock-converse/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.6.0/v0.5.0",
    "kernel_version": "0.5.0",
    "kernel_revision": "c0bca10c2d9f9a439680865feb65c9edf598fc65",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.74.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 4,
      "error_catalog": 1,
      "stream": 2
    }
  },
  "emits": [
    "authorization",
    "x-amz-date",
    "x-amz-content-sha256",
    "x-amz-security-token"
  ],
  "stream_framing": "aws-eventstream",
  "signing": {
    "scheme": "aws-sigv4",
    "service": "bedrock",
    "region": {
      "template_param": "region"
    },
    "credentials": {
      "access_key_id": "access_key_id",
      "secret_access_key": "secret_access_key",
      "session_token": "session_token"
    }
  },
  "request_facts": {
    "bedrock": {
      "output_cap": [
        "/inferenceConfig/maxTokens"
      ],
      "model": {
        "url": "/model/{model}/converse"
      },
      "stream": "url"
    }
  }
}
