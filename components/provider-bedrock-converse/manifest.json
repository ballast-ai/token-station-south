{
  "name": "provider-bedrock-converse",
  "version": "1.0.6",
  "api_version": "provider-adapter-v2",
  "providers": [
    "bedrock"
  ],
  "capabilities": [
    "chat",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "host_signed"
  ],
  "endpoint": {
    "bedrock": "https://bedrock-runtime.{region}.amazonaws.com"
  },
  "config_schema": {
    "bedrock": {
      "region": {
        "syntax": "aws_region",
        "required": true,
        "description": "The AWS region the Bedrock runtime is called in."
      }
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": []
  },
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures-bedrock-converse/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.4.0/v0.3.0",
    "kernel_version": "0.3.0",
    "kernel_revision": "6822aab1dea54ef646cb2206595cd4955ff9764a",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.43.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 2,
      "error_catalog": 1,
      "stream": 2
    }
  },
  "emits": [
    "authorization",
    "x-amz-date",
    "x-amz-content-sha256",
    "x-amz-security-token"
  ],
  "stream_framing": "aws-eventstream",
  "signing": {
    "scheme": "aws-sigv4",
    "service": "bedrock",
    "region": {
      "template_param": "region"
    },
    "credentials": {
      "access_key_id": "access_key_id",
      "secret_access_key": "secret_access_key",
      "session_token": "session_token"
    }
  },
  "request_facts": {
    "bedrock": {
      "output_cap": [
        "/inferenceConfig/maxTokens"
      ],
      "model": {
        "url": "/model/{model}/converse"
      },
      "stream": "url"
    }
  }
}
