{
  "name": "provider-anthropic",
  "version": "1.3.0",
  "api_version": "provider-adapter-v2",
  "providers": [
    "anthropic",
    "claude-code",
    "claude-code-setup-token"
  ],
  "capabilities": [
    "chat",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "bearer",
    "header_secret"
  ],
  "request_facts": {
    "anthropic": {
      "output_cap": [
        "/max_tokens"
      ],
      "model": {
        "body": "/model"
      },
      "stream": {
        "body": "/stream"
      }
    }
  },
  "immutable_body_paths": {
    "claude-code": [
      "system"
    ]
  },
  "immutable_request_headers": {
    "claude-code": [
      "accept",
      "anthropic-beta",
      "anthropic-dangerous-direct-browser-access",
      "anthropic-version",
      "authorization",
      "content-type",
      "user-agent",
      "x-api-key",
      "x-app"
    ],
    "claude-code-setup-token": [
      "accept",
      "anthropic-beta",
      "anthropic-dangerous-direct-browser-access",
      "anthropic-version",
      "authorization",
      "content-type",
      "user-agent",
      "x-api-key",
      "x-app"
    ]
  },
  "credentials": {
    "schema": "south.credential-recipe.v1",
    "families": [
      "claude-code"
    ],
    "fields": {
      "refresh_token": {
        "secret": true,
        "required": true,
        "description": "The Claude Code refresh token, claudeAiOauth.refreshToken in the CLI's .credentials.json. Rotated on every refresh and written back. A token without one is a setup token: use the claude-code-setup-token family."
      }
    },
    "import": {
      "refresh_token": {
        "file": "claude-code-credentials-json",
        "pointers": [
          "/claudeAiOauth/refreshToken"
        ]
      }
    },
    "seed": {
      "file": "claude-code-credentials-json",
      "slot": "provider_api_key",
      "present": "/claudeAiOauth/accessToken",
      "expires_at": {
        "epoch_millis": "/claudeAiOauth/expiresAt"
      }
    },
    "slots": {
      "provider_api_key": {
        "minted": "claude_code"
      }
    },
    "recipes": {
      "claude_code": {
        "steps": [
          {
            "id": "refresh",
            "kind": "oauth2_token",
            "encoding": "json",
            "endpoint": "https://console.anthropic.com/v1/oauth/token",
            "requires": [
              "refresh_token"
            ],
            "params": {
              "client_id": {
                "const": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
              },
              "grant_type": {
                "const": "refresh_token"
              },
              "refresh_token": {
                "field": "refresh_token"
              }
            },
            "on_status": {
              "400": "reauth_required",
              "401": "reauth_required",
              "4xx": "transient"
            },
            "extract": {
              "access_token": {
                "pointer": "/access_token",
                "secret": true
              },
              "expires_at": {
                "relative_seconds": "/expires_in"
              },
              "refresh_token": {
                "pointer": "/refresh_token",
                "secret": true,
                "optional": true
              }
            }
          }
        ],
        "present": "refresh.access_token",
        "rotates_refresh_material": true,
        "write_back": {
          "refresh_token": "refresh.refresh_token"
        },
        "without_refresh_material": "fail",
        "default_seconds": 60
      }
    }
  },
  "endpoint": {
    "anthropic": "https://api.anthropic.com",
    "claude-code": "https://api.anthropic.com",
    "claude-code-setup-token": "https://api.anthropic.com"
  },
  "user_agent": {
    "claude-code": "claude-cli/2.1.114 (external, cli)"
  },
  "subscription_quota_families": [
    "claude-code",
    "claude-code-setup-token"
  ],
  "north_passthrough": {
    "anthropic": "messages"
  },
  "north_request_passthrough": {
    "anthropic": "messages"
  },
  "forwarded_client_headers": {
    "anthropic": [
      "anthropic-beta"
    ]
  },
  "count_tokens": {
    "anthropic": {
      "protocol": "messages",
      "path_suffix": {
        "from": "/v1/messages",
        "to": "/v1/messages/count_tokens"
      }
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "host_values": [
    "end_user_hash"
  ],
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures-anthropic/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.6.0/v0.5.0",
    "kernel_version": "0.5.0",
    "kernel_revision": "c0bca10c2d9f9a439680865feb65c9edf598fc65",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.67.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 4,
      "error_catalog": 1,
      "stream": 2
    }
  }
}
