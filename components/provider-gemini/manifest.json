{
  "name": "provider-gemini",
  "version": "1.1.6",
  "api_version": "provider-adapter-v2",
  "providers": [
    "gemini"
  ],
  "capabilities": [
    "chat",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "header_secret"
  ],
  "request_facts": {
    "gemini": {
      "output_cap": [
        "/generationConfig/maxOutputTokens"
      ],
      "model": {
        "url": "/models/{model}:"
      },
      "stream": "url"
    }
  },
  "endpoint": {
    "gemini": "https://generativelanguage.googleapis.com"
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures-gemini/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.4.0/v0.3.0",
    "kernel_version": "0.3.0",
    "kernel_revision": "6822aab1dea54ef646cb2206595cd4955ff9764a",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.44.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 2,
      "error_catalog": 1,
      "stream": 2
    }
  }
}
