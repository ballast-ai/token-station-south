{
  "name": "provider-gemini",
  "version": "1.7.5",
  "api_version": "provider-adapter-v2",
  "providers": [
    "gemini"
  ],
  "capabilities": [
    "chat",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "header_secret"
  ],
  "request_facts": {
    "gemini": {
      "output_cap": [
        "/generationConfig/maxOutputTokens"
      ],
      "model": {
        "url": "/models/{model}:"
      },
      "stream": "url"
    }
  },
  "endpoint": {
    "gemini": "https://generativelanguage.googleapis.com"
  },
  "north_passthrough": {
    "gemini": "generate_content"
  },
  "north_request_passthrough": {
    "gemini": "generate_content"
  },
  "count_tokens": {
    "gemini": {
      "protocol": "generate_content",
      "path_suffix": {
        "from": ":generateContent",
        "to": ":countTokens"
      }
    }
  },
  "model_parameters": {
    "gemini": {
      "words": [
        "anthropic.tool_choice.auto_only"
      ]
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures-gemini/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.7.0/v0.6.0",
    "kernel_version": "0.6.0",
    "kernel_revision": "a04925518b95c6557374252db7fbe7f026688bde",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.77.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 5,
      "error_catalog": 1,
      "stream": 3
    }
  }
}
