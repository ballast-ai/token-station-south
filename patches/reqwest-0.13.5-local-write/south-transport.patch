+#[tokio::test]
+#[allow(clippy::too_many_lines)] // One controlled request spans independently gated server phases.
+async fn local_flush_is_not_server_body_complete_or_queue_admission() {
+    tokio::time::timeout(Duration::from_secs(3), async {
+    use std::{
+        sync::atomic::{AtomicBool, Ordering},
+        time::Instant,
+    };
+    struct WriteSink {
+        events: Mutex<Vec<(&'static str, Instant)>>,
+        notify: tokio::sync::Notify,
+    }
+    impl TransportObserver for WriteSink {
+        fn event(&self, _: &str, _: &'static str, _: Duration) {}
+        fn local_write(&self, _: &str, s: &'static str, _: u64) {
+            self.events.lock().unwrap().push((s, Instant::now()));
+            self.notify.notify_one();
+        }
+    }
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let (headers_tx, headers_rx) = tokio::sync::oneshot::channel();
+    let (read_tx, read_rx) = tokio::sync::oneshot::channel();
+    let (body_tx, body_rx) = tokio::sync::oneshot::channel();
+    let (admit_tx, admit_rx) = tokio::sync::oneshot::channel();
+    let (admitted_tx, admitted_rx) = tokio::sync::oneshot::channel();
+    let (respond_tx, respond_rx) = tokio::sync::oneshot::channel();
+    let server_complete = Arc::new(AtomicBool::new(false));
+    let state = server_complete.clone();
+    let server = tokio::spawn(async move {
+        let (mut socket, _) = listener.accept().await.unwrap();
+        let mut h = Vec::new();
+        while !h.ends_with(b"\r\n\r\n") {
+            let mut b = [0; 1];
+            assert_eq!(socket.read(&mut b).await.unwrap(), 1);
+            h.extend_from_slice(&b);
+        }
+        let text = String::from_utf8(h).unwrap();
+        assert!(text.to_lowercase().contains("content-length: 16"));
+        assert!(!text.to_lowercase().contains("transfer-encoding"));
+        headers_tx.send(()).unwrap();
+        read_rx.await.unwrap();
+        let mut body = [0; 16];
+        socket.read_exact(&mut body).await.unwrap();
+        assert_eq!(&body, b"{\"effort\":\"low\"}");
+        let received = Instant::now();
+        state.store(true, Ordering::SeqCst);
+        body_tx.send(received).unwrap();
+        let queued = Instant::now();
+        admit_rx.await.unwrap();
+        let admitted = Instant::now();
+        admitted_tx.send((queued, admitted)).unwrap();
+        respond_rx.await.unwrap();
+        socket
+            .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
+            .await
+            .unwrap();
+    });
+    let sink = Arc::new(WriteSink {
+        events: Mutex::new(Vec::new()),
+        notify: tokio::sync::Notify::new(),
+    });
+    let client = reqwest::Client::builder()
+        .no_proxy().timeout(Duration::from_secs(2))
+        .pilot_write_observer(Arc::new(observation::LocalWriteBridge(sink.clone())))
+        .build()
+        .unwrap();
+    let call = tokio::spawn(async move {
+        client
+            .post(format!("http://{addr}/mock"))
+            .header("x-request-id", "req_mock")
+            .body("{\"effort\":\"low\"}")
+            .send()
+            .await
+            .unwrap()
+            .bytes()
+            .await
+            .unwrap()
+    });
+    headers_rx.await.unwrap();
+    loop {
+        if sink
+            .events
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|e| e.0 == "south_local_request_flush_complete")
+        {
+            break;
+        }
+        sink.notify.notified().await;
+    }
+    assert!(!server_complete.load(Ordering::SeqCst));
+    assert!(!call.is_finished());
+    let flushed = sink
+        .events
+        .lock()
+        .unwrap()
+        .iter()
+        .find(|e| e.0 == "south_local_request_flush_complete")
+        .unwrap()
+        .1;
+    read_tx.send(()).unwrap();
+    let received = body_rx.await.unwrap();
+    assert!(received >= flushed);
+    assert!(!call.is_finished());
+    admit_tx.send(()).unwrap();
+    let (queued, admitted) = admitted_rx.await.unwrap();
+    assert!(admitted >= queued && queued >= received);
+    assert!(!call.is_finished());
+    respond_tx.send(()).unwrap();
+    assert_eq!(call.await.unwrap(), b"ok".as_slice());
+    server.await.unwrap();
+    println!(
+        "MOCK_BOUNDARIES {{\"local_flush_before_mock_body_received\":true,\"mock_queue_separately_gated\":true,\"body_received_after_local_flush_ms\":{},\"mock_queue_wait_ms\":{},\"real_upstream_observed\":false}}",
+        received.duration_since(flushed).as_secs_f64() * 1000.0,
+        admitted.duration_since(queued).as_secs_f64() * 1000.0
+    );
+}).await.expect("mock boundary test must finish within three seconds");
